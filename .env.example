# Template only. This file lists the variable names and holds no values, which
# is what makes it safe to read and safe to commit.
#
# The live credentials are NOT here, and no file in this repo holds them. They
# live outside the working directory, so that no search over the repo can reach
# them whatever the tool or the command:
#
#   ~/.prelude/.env    the default, which is C:\Users\shawn\.prelude\.env here
#   PRELUDE_ENV_FILE   set this to read them from somewhere else
#
# Copy this file to that location and fill it in. A path inside the repo is
# refused rather than read; see app/credentials.py.

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com

TTS_API_KEY=
TTS_URL=

# An IBM Watson Text to Speech voice name. en-GB_GeorgeExpressive is the
# working default; en-GB_GeorgeNatural is the alternative. Nothing in the repo
# reads these yet: audio is Phase 5.
TTS_VOICE=en-GB_GeorgeExpressive
